# ══════════════════════════════════════════════════════════════
#  SODA TYCOON — Environment Variables
#  این فایل را به .env کپی کنید و مقادیر واقعی قرار دهید
# ══════════════════════════════════════════════════════════════

# ── Backend ───────────────────────────────────────────────────
# پورت اجرای Backend (پیش‌فرض 3000)
PORT=3000

# محیط اجرا: development یا production
NODE_ENV=development

# آدرس عمومی Backend (برای Bot و Mini App). بدون اسلش انتهایی.
# در Production باید HTTPS باشد.
BACKEND_URL=http://localhost:3000

# آدرس عمومی Mini App (پس از Build، پوشه dist سرو می‌شود). بدون اسلش انتهایی.
WEBAPP_URL=http://localhost:5174

# کلید رمزنگاری JWT — حتماً یک رشته تصادفی طولانی (۶۴+ کاراکتر)
# تولید خودکار: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# مدت اعتبار توکن JWT بازیکنان (مثال: 30d)
JWT_EXPIRES_IN=30d

# آدرس اتصال PostgreSQL
# نمونه محلی: postgresql://postgres:YOUR_PASSWORD@localhost:5432/soda_tycoon
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/soda_tycoon

# ── Telegram Bot ──────────────────────────────────────────────
# توکن ربات را از @BotFather بگیرید. کاملاً محرمانه است!
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# آدرس Mini App که در منوی ربات باز می‌شود (همان WEBAPP_URL)
MINIAPP_URL=http://localhost:5174

# آدرس Backend که Bot برای اعلان‌ها به آن وصل می‌شود
BACKEND_API_URL=http://localhost:3000

# کلید مشترک Bot ↔ Backend (باید در backend/.env هم همین باشد)
BOT_API_KEY=dev-bot-key

# ── Admin Panel ───────────────────────────────────────────────
# آدرس Backend که پنل ادمین به آن وصل می‌شود
VITE_API_URL=http://localhost:3000

# آدرس Mini App که پنل ادمین در بخش کاربر لینک می‌کند
VITE_WEBAPP_URL=http://localhost:5174

# ── Mini App ──────────────────────────────────────────────────
# آدرس Backend که Mini App به آن وصل می‌شود
VITE_BACKEND_URL=http://localhost:3000

# ── امنیت ─────────────────────────────────────────────────────
# در Production حتماً true باشد (فعال‌سازی Rate limit سخت‌گیرانه)
STRICT_RATE_LIMIT=false
